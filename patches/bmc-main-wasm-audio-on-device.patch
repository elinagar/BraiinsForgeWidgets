+    /// The sound card, opened for a clip that is about to start.
+    ///
+    /// The Deck's ALSA `default` is a software-volume layer straight over the
+    /// hardware with no mixing, so only one process may hold it. The stream is
+    /// opened here on demand and dropped by [`Self::release_idle_audio`] once
+    /// every clip has drained, leaving the card free for the system's alarms
+    /// between widget cues. A busy card drops the clip with a warning.
+    #[cfg(feature = "audio")]
+    pub fn audio_output(&mut self) -> Option<rodio::OutputStreamHandle> {
+        if self.audio_stream.is_none() {
+            match rodio::OutputStream::try_default() {
+                Ok(pair) => self.audio_stream = Some(pair),
+                Err(e) => {
+                    tracing::warn!("audio output unavailable: {e} — clip dropped");
+                    return None;
+                }
+            }
+        }
+        self.audio_stream.as_ref().map(|(_, handle)| handle.clone())
+    }
+
+    /// Keep the output open until at least `until_ms` on the monotonic clock.
+    #[cfg(feature = "audio")]
+    pub fn hold_audio_until(&mut self, until_ms: u64) {
+        self.audio_idle_at_ms = Some(self.audio_idle_at_ms.map_or(until_ms, |t| t.max(until_ms)));
+    }
+
+    /// Drop the output once the hold has passed and no sink is still playing.
+    /// Called on every clock update and when the widget goes dormant.
+    #[cfg(feature = "audio")]
+    pub fn release_idle_audio(&mut self, force: bool) {
+        let due = self
+            .audio_idle_at_ms
+            .is_some_and(|at| self.monotonic_ms >= at);
+        if self.audio_stream.is_some() && (force || (due && self.audio.all_drained())) {
+            self.audio.clear_sinks();
+            self.audio_stream = None;
+            self.audio_idle_at_ms = None;
+        }
+    }
+
